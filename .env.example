# Bulkhead — every variable the app reads. Copy to .env, or run `pnpm gen:env` to create .env with
# fresh secrets (it never prints them; it prints only the operator address to fund).
# PREPROD ONLY. Never put mainnet keys here.

# ── Required for the on-chain demo ──
# Blockfrost preprod project id (https://blockfrost.io, free tier). Without it the app falls back to
# Koios' keyless public tier, which is rate-limited (5,000 requests/day per IP).
BLOCKFROST_PREPROD_PROJECT_ID=
# Operator wallet: mints test tUSD and simulates the fiat on-ramp. Generated by `pnpm gen:env`;
# fund its address from https://docs.cardano.org/cardano-testnets/tools/faucet
OPERATOR_MNEMONIC=
# 32-byte hex. Root for derived treasury/session/captain keys and the AES-256-GCM key-encryption key.
MASTER_SECRET=

# ── Sign-in (Auth.js) ──
NEXTAUTH_SECRET=
# Optional Google sign-in. Without it, DEMO_LOGIN=1 shows a labelled "Demo login" for judges.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DEMO_LOGIN=1

# ── Top-up (Stripe TEST mode, optional) ──
# Without these the UI uses a clearly labelled simulated checkout that triggers the same on-chain top-up.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MYR_PER_TUSD=4.70
TOPUP_FEE_PCT=1.5

# ── Chain providers (optional) ──
# NOWNodes serves Cardano mainnet only, so it is used for mainnet dashboard reads, never for preprod txs.
NOWNODES_API_KEY=
KOIOS_API_TOKEN=
# Ogmios WebSocket for chain-sync (e.g. a Demeter preprod endpoint). Without it the watcher polls every 10 s.
OGMIOS_URL=

# ── AI (optional) ──
# Without a key, a deterministic MockLLM drives the captain and sub-agents (the demo and tests still run).
ANTHROPIC_API_KEY=
# Or OpenAI (used when ANTHROPIC_API_KEY is empty). Captain = OPENAI_MODEL, sub-agents = OPENAI_SUBAGENT_MODEL.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_SUBAGENT_MODEL=gpt-5.6-luna

# ── Runtime ──
MAX_PARALLEL_SESSIONS=5
DATABASE_PATH=./data/bulkhead.sqlite
ENGINE_URL=http://localhost:4000
# Shared secret between the web app and the engine API. Generated by `pnpm gen:env`.
ENGINE_TOKEN=
MARKET_URL=http://localhost:4100
PUBLIC_WEB_URL=http://localhost:3000

# ── Top-up ADA float ──
# tADA sent with every top-up so the treasury can pay min-ADA for session outputs and fees
# (preprod tADA is free). The spec's "+2 ADA" is the floor.
TOPUP_ADA=25

# ── Offline demo / tests ──
# CHAIN=fake runs the whole engine on an in-memory chain (no Blockfrost, no faucet) — for UI demos only.
# Never use it for the judged on-chain demo.
CHAIN=
# Mock market overrides (normally derived from MASTER_SECRET / the operator's tUSD policy).
TUSD_UNIT=
MARKET_AGENT_ADDRESS_0=
MARKET_AGENT_ADDRESS_1=
MARKET_AGENT_ADDRESS_2=
MARKET_POLL_MS=10000

# ── Staking + vote delegation (treasury) ──
# Preprod pool to delegate treasuries to (pool1…). Empty = pick an active, unsaturated preprod pool automatically.
STAKE_POOL_ID=
# DRep to delegate voting power to (drep1…). Empty = always_abstain (needed for reward withdrawals since Conway).
DREP_ID=

# Session wallet type: "vault" (default — Aiken Session Vault, needs Blockfrost) or "native" (native-script fallback).
WALLET_MODE=vault

# Blocks that must sit on top of a tx before it counts as confirmed (funding, payments, closes, top-ups). 1–100.
CONFIRMATIONS=2

# ── Masumi Standard API (MIP-003, MIP-004 hashes) — loopback only ──
STANDARD_API_PORT=4200
STANDARD_API_DATA_DIR=./data/standard-jobs
STANDARD_API_ENGINE_USER_EMAIL=masumi-standard@bulkhead.local
STANDARD_API_GOAL_BUDGET_TUSD=2
STANDARD_API_RESULT_MINUTES=60
STANDARD_API_POLL_MS=10000
# 1 = run jobs without payment (local testing only)
STANDARD_API_FREE=
# Paid mode: the dedicated MPS (127.0.0.1:3901) and a scoped token (keep it in .local/, never commit)
STANDARD_MPS_URL=http://127.0.0.1:3901
STANDARD_MPS_TOKEN=
STANDARD_MPS_AGENT_IDENTIFIER=
STANDARD_MPS_PAYMENT_SOURCE_INDEX=0
STANDARD_MPS_PAYMENT_SOURCE_TYPE=Web3CardanoV2
STANDARD_MPS_PRICE_UNIT=
STANDARD_MPS_PRICE_AMOUNT=

# ── Hire real Masumi agents (hire_agent sessions) — default stays the mock market ──
# MARKET=masumi switches hire_agent to Masumi registry agents paid through the dedicated MPS.
MARKET=
MASUMI_MPS_URL=http://127.0.0.1:3901/api/v1
MASUMI_NETWORK=Preprod
# Scoped tokens live in private files (never in this file): buyer = canRead+canPay on the Purchasing wallet.
MASUMI_MPS_BUYER_ENV_FILE=.local/mps-buyer.env
MASUMI_MPS_ADMIN_ENV_FILE=.local/mps-admin.env
MASUMI_USD_UNITS=
MASUMI_TUSD_PER_ADA=
MASUMI_MAX_PRICE_TUSD=5
MASUMI_AGENT_ALLOWLIST=
MASUMI_REQUIRE_ONCHAIN_RESULT=1
MASUMI_JOB_TIMEOUT_MS=2700000
