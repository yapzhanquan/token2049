# Bulkhead — every variable the app reads. Copy to .env, or run `pnpm gen:env` to create .env with
# fresh secrets (it never prints them; it prints only the operator address to fund).
# PREPROD ONLY. Never put mainnet keys here.

# ── Required for the on-chain demo ──
# Blockfrost preprod project id (https://blockfrost.io, free tier). Without it the app falls back to
# Koios' keyless public tier, which is rate-limited (5,000 requests/day per IP).
BLOCKFROST_PREPROD_PROJECT_ID=
# Operator wallet: mints test tUSD and simulates the fiat on-ramp. Generated by `pnpm gen:env`;
# fund its address from https://docs.cardano.org/cardano-testnets/tools/faucet
OPERATOR_MNEMONIC=
# 32-byte hex. Root for derived treasury/session/captain keys and the AES-256-GCM key-encryption key.
MASTER_SECRET=

# ── Sign-in (Auth.js) ──
NEXTAUTH_SECRET=
# Optional Google sign-in. Without it, DEMO_LOGIN=1 shows a labelled "Demo login" for judges.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DEMO_LOGIN=1

# ── Settlement asset (budgets, funding, Session Vault tusd_policy/tusd_name, payments, balances) ──
# Default tUSDM = Masumi/Sokosumi preprod stablecoin, so money earned on Sokosumi can fund crews:
#   16a55b2a349361ff88c03788f93e1e966e5d689605d044fef722ddde0014df10745553444d (CIP-68 333 "tUSDM", 6 decimals)
# tUSDM cannot be minted by the operator: custodial treasuries (and the operator, for top-ups) must HOLD it.
# "tusd" = fallback to Bulkhead's self-minted test tUSD (operator policy; top-ups mint it on demand).
SETTLEMENT_ASSET=tusdm
# Optional explicit unit (policyId + asset name hex, 6 decimals); wins over SETTLEMENT_ASSET. Ticker shown in the UI.
SETTLEMENT_UNIT=
SETTLEMENT_TICKER=

# ── Top-up (Stripe TEST mode, optional) ──
# Without these the UI uses a clearly labelled simulated checkout that triggers the same on-chain top-up.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MYR_PER_TUSD=4.70
TOPUP_FEE_PCT=1.5

# ── Chain providers (optional) ──
# NOWNodes serves Cardano mainnet only, so it is used for mainnet dashboard reads, never for preprod txs.
NOWNODES_API_KEY=
KOIOS_API_TOKEN=
# Ogmios WebSocket for chain-sync (e.g. a Demeter preprod endpoint). Without it the watcher polls every 10 s.
OGMIOS_URL=

# ── AI (optional) ──
# Without a key, a deterministic MockLLM drives the captain and sub-agents (the demo and tests still run).
ANTHROPIC_API_KEY=
# Or OpenAI (used when ANTHROPIC_API_KEY is empty). Captain = OPENAI_MODEL, sub-agents = OPENAI_SUBAGENT_MODEL.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_SUBAGENT_MODEL=gpt-5.6-luna

# ── Runtime ──
DATABASE_PATH=./data/bulkhead.sqlite
ENGINE_URL=http://localhost:4000
# Bind addresses (loopback by default; set 0.0.0.0 only to expose on purpose).
# ENGINE_HOST=127.0.0.1
# WEB_HOST=127.0.0.1
# MARKET_HOST=127.0.0.1
# Delegated funding: custodial API users whose POST /goals are funded at creation (inside the goal mandate).
# Default: the Sokosumi worker + Masumi Standard API users. "none" disables it.
# AUTO_FUND_USER_EMAILS=sokosumi-coworker@bulkhead.local,masumi-standard@bulkhead.local
# Child/hand-off spawns within this window share one top-up tx (ms, 0 = one tx each).
# SPAWN_BATCH_MS=300
# Retry / re-check approved goals whose sessions still wait for funding (ms, 0 = boot + deposits only).
# GOAL_RECONCILE_MS=60000
# Concurrency cap: sessions with a live forked silo at once (extra ones queue in FUNDING).
MAX_PARALLEL_SESSIONS=5
# Work deadline: every session's WORKING time, counted from RUNNING (wallet funded). At T-WORK_WRAPUP_SECONDS the
# sub-agent is told to wrap up; at T it hands back what it has ("partial: time limit"); WORK_GRACE_SECONDS later the
# captain's watchdog collects anything still open and the session closes (Revoke) at once. 0 = no work limit.
# WORK_DEADLINE_SECONDS=60
# WORK_WRAPUP_SECONDS=15
# WORK_GRACE_SECONDS=5
# On-chain windows (separate, minimal-but-valid): vault expiry = now + funding allowance + work (per wave) + buffer.
# VAULT_FUNDING_ALLOWANCE_SECONDS=300
# VAULT_EXPIRY_BUFFER_SECONDS=300
# Shared secret between the web app and the engine API. Generated by `pnpm gen:env`.
ENGINE_TOKEN=
MARKET_URL=http://localhost:4100
PUBLIC_WEB_URL=http://localhost:3000

# ── Top-up ADA float ──
# tADA sent with every top-up so the treasury can pay min-ADA for session outputs and fees
# (preprod tADA is free). The spec's "+2 ADA" is the floor.
TOPUP_ADA=25

# ── Offline demo / tests ──
# CHAIN=fake runs the whole engine on an in-memory chain (no Blockfrost, no faucet) — for UI demos only.
# Never use it for the judged on-chain demo.
CHAIN=
# Bulkhead's own tUSD unit (normally derived from the operator's tUSD policy). It does NOT select the settlement
# asset (SETTLEMENT_ASSET does); the mock market matches payments in the settlement unit.
TUSD_UNIT=
MARKET_AGENT_ADDRESS_0=
MARKET_AGENT_ADDRESS_1=
MARKET_AGENT_ADDRESS_2=
MARKET_POLL_MS=10000

# ── Staking + vote delegation (treasury) ──
# Preprod pool to delegate treasuries to (pool1…). Empty = pick an active, unsaturated preprod pool automatically.
STAKE_POOL_ID=
# DRep to delegate voting power to (drep1…). Empty = always_abstain (needed for reward withdrawals since Conway).
DREP_ID=

# Session wallet type: "vault" (default — Aiken Session Vault, needs Blockfrost) or "native" (native-script fallback).
WALLET_MODE=vault

# Blocks that must sit on top of a tx before it counts as confirmed (funding, payments, closes, top-ups). 1–100.
CONFIRMATIONS=2

# ── Masumi Standard API (MIP-003, MIP-004 hashes) — loopback only ──
STANDARD_API_PORT=4200
STANDARD_API_DATA_DIR=./data/standard-jobs
STANDARD_API_ENGINE_USER_EMAIL=masumi-standard@bulkhead.local
STANDARD_API_GOAL_BUDGET_TUSD=2
STANDARD_API_RESULT_MINUTES=60
STANDARD_API_POLL_MS=10000
# 1 = run jobs without payment (local testing only)
STANDARD_API_FREE=
# Paid mode: the dedicated MPS (127.0.0.1:3901) and a scoped token (keep it in .local/, never commit)
STANDARD_MPS_URL=http://127.0.0.1:3901
STANDARD_MPS_TOKEN=
STANDARD_MPS_AGENT_IDENTIFIER=
STANDARD_MPS_PAYMENT_SOURCE_INDEX=0
STANDARD_MPS_PAYMENT_SOURCE_TYPE=Web3CardanoV2
STANDARD_MPS_PRICE_UNIT=
STANDARD_MPS_PRICE_AMOUNT=

# ── Hire real Masumi agents (hire_agent sessions) — default stays the mock market ──
# MARKET=masumi switches hire_agent to Masumi registry agents paid through the dedicated MPS (comma list: masumi,sokosumi).
MARKET=
MASUMI_MPS_URL=http://127.0.0.1:3901/api/v1
MASUMI_NETWORK=Preprod
# Scoped tokens live in private files (never in this file): buyer = canRead+canPay on the Purchasing wallet.
MASUMI_MPS_BUYER_ENV_FILE=.local/mps-buyer.env
MASUMI_MPS_ADMIN_ENV_FILE=.local/mps-admin.env
MASUMI_USD_UNITS=
MASUMI_TUSD_PER_ADA=
MASUMI_MAX_PRICE_TUSD=5
MASUMI_AGENT_ALLOWLIST=
MASUMI_REQUIRE_ONCHAIN_RESULT=1
MASUMI_JOB_TIMEOUT_MS=2700000

# ── Hire Sokosumi agents with CREDITS (off-chain), billed ONLY to one organization workspace ──
# MARKET=sokosumi (catalog = mock + Sokosumi) or MARKET=masumi,sokosumi (Masumi + Sokosumi). The engine refuses to
# start the Sokosumi market without the org slug + id. Every request carries X-Organization-Slug (except the
# read-only personal-balance control read); a personal/other-workspace credit decrease disables the market.
SOKOSUMI_API_KEY=
SOKOSUMI_API_URL=https://api.preprod.sokosumi.com
SOKOSUMI_HIRE_ORGANIZATION_SLUG=
SOKOSUMI_HIRE_ORGANIZATION_ID=
# Optional: Sokosumi user id for the balance endpoints (default "me").
SOKOSUMI_USER_ID=
# Mandate cap: maxCredits = floor(min(remaining session budget, per-payment max) x rate), at most the ceiling.
# Default rate 100 credits per 1 tUSDM (sokosumi-marketplace.md: 1 credit ~ $0.01).
SOKOSUMI_CREDITS_PER_TUSDM=100
SOKOSUMI_MAX_CREDITS_PER_HIRE=10
SOKOSUMI_AGENT_ALLOWLIST=
SOKOSUMI_JOB_TIMEOUT_MS=1200000
