# apps/sokosumi-worker — loaded after ../../.env (ENGINE_URL, ENGINE_TOKEN, BLOCKFROST_PREPROD_PROJECT_ID come from there).
# Preprod only. The Coworker runtime key lives in the Sokosumi CLI's OS vault (runtime key-import), never here.

# Registered Coworker id (required)
SOKOSUMI_COWORKER_ID=
# Only for Sokosumi CLI 1.0.0 (runtime start/complete need --organization-id). Leave empty on CLI >= 1.0.4 (--personal).
SOKOSUMI_ORGANIZATION_ID=
# Organization Workspace slug for `tasks list` (CLI 1.0.0 tasks commands take --organization-slug, not --organization-id).
SOKOSUMI_ORGANIZATION_SLUG=
# Optional: path of the installed CLI package (default: `sokosumi skills path`, else `npm root -g`).
SOKOSUMI_CLI_ROOT=
SOKOSUMI_ENGINE_USER_EMAIL=sokosumi-coworker@bulkhead.local
SOKOSUMI_WORKER_STATE_DIR=
POLL_INTERVAL_MS=5000

# Quote: price (tUSDM) = crew budget + fee, capped
BULKHEAD_FEE_TUSDM=0.5
MAX_QUOTE_TUSDM=20
DEFAULT_CREW_BUDGET_TUSDM=2
# Task (result) deadline when the Task names none. 0 = the minimum the payment service accepts (~18 min with the
# defaults below); a Task deadline under that minimum is raised with a note.
DEFAULT_DEADLINE_MINUTES=0
MIN_DEADLINE_MINUTES=15
MAX_DEADLINE_HOURS=168
DECISION_ASK_TIMEOUT_MINUTES=10
COMMENT_WINDOW_HOURS=72
SOKOSUMI_GOAL_RULES=

# Paid Tasks (dedicated MPS). Enable only after funding + RegistrationConfirmed.
PAID_TASKS_ENABLED=false
MPS_URL=
# File containing MPS_RUNTIME_TOKEN= (scoped ReadAndPay key). Default: .local/mps-runtime.env
MPS_RUNTIME_ENV_PATH=
MASUMI_REGISTRATION_CONFIRMED=false
MASUMI_AGENT_IDENTIFIER=
# supportedPaymentSourceIndex of the registration (MASUMI_SUPPORTED_PAYMENT_SOURCE_INDEX is accepted as an alias)
MASUMI_PAYMENT_SOURCE_INDEX=0
MASUMI_SELLER_WALLET_ID=
MASUMI_SELLER_ADDRESS=
# Escrow window: >= 12 (lower values are raised; the preprod escrow lock took ~9 min). MPS needs the result >= 5 min
# after pay-by and >= 15 min ahead; the worker asks for exactly the minimum (+1 min skew).
PAY_BY_MINUTES=12
# The crew works this long once the escrow is locked (same knob as the engine's WORK_DEADLINE_SECONDS).
WORK_DEADLINE_SECONDS=60
# After the work: close the session wallets + submit the result hash.
RESULT_MARGIN_MINUTES=3
